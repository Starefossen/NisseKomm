{
  "name": "nissekomm",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.24.0",
  "scripts": {
    "build": "next build",
    "check": "tsc --noEmit && eslint . && knip && prettier --write --list-different . && jest --silent",
    "cleanup:dev": "tsx scripts/cleanup-test-sessions.ts --dataset development",
    "dev": "next dev",
    "email:dev": "tsx scripts/send-welcome-emails.ts --dataset development",
    "email:prod": "tsx scripts/send-welcome-emails.ts --dataset production",
    "email:daily-dev": "tsx scripts/send-daily-mission-emails.ts --dataset development",
    "email:daily-prod": "tsx scripts/send-daily-mission-emails.ts --dataset production",
    "format": "prettier --write --list-different .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "knip:fix": "knip --fix",
    "leaderboard:dev": "tsx scripts/leaderboard.ts --dataset development",
    "leaderboard:prod": "tsx scripts/leaderboard.ts --dataset production",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "migration:list": "sanity migration list",
    "migration:run:dev": "SANITY_STUDIO_DATASET=development sanity migration run",
    "migration:run:prod": "SANITY_STUDIO_DATASET=production sanity migration run",
    "sanity": "sanity",
    "sanity:dev": "SANITY_STUDIO_DATASET=development sanity",
    "sanity:prod": "SANITY_STUDIO_DATASET=production sanity",
    "start": "next start",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:debug": "node --inspect-brk node_modules/.bin/jest --runInBand",
    "test:silent": "jest --silent",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@sanity/client": "^8.9.0",
    "@sanity/vision": "^6.19.0",
    "@vercel/analytics": "^2.0.1",
    "date-fns": "^4.4.0",
    "html5-qrcode": "^2.3.8",
    "next": "^16.4.0",
    "pixelarticons": "^2.4.2",
    "qr-code-styling": "^1.9.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "resend": "^6.33.0",
    "sanity": "^6.19.0",
    "styled-components": "^6.6.0",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@jest/globals": "^30.5.2",
    "@sanity/migrate": "^8.0.5",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "dotenv": "^18.0.8",
    "eslint": "^10.12.0",
    "eslint-config-next": "^16.4.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "knip": "^6.41.0",
    "next-test-api-route-handler": "^5.0.7",
    "postcss": "^8.5.30",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
