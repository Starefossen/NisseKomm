{
  "name": "nissekomm",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.24.0",
  "scripts": {
    "build": "next build",
    "icons": "node -e \"require('fs').cpSync('node_modules/pixelarticons/svg','public/icons',{recursive:true})\"",
    "postinstall": "pnpm icons",
    "prebuild": "pnpm icons",
    "check": "tsc --noEmit && eslint . && knip && prettier --write --list-different . && jest --silent",
    "dev": "next dev",
    "format": "prettier --write --list-different .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "knip:fix": "knip --fix",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "start": "next start",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:debug": "node --inspect-brk node_modules/.bin/jest --runInBand",
    "test:silent": "jest --silent",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "html5-qrcode": "^2.3.8",
    "jose": "^6.2.16",
    "next": "^16.4.0",
    "pg": "^8.23.1",
    "pixelarticons": "^2.4.2",
    "qr-code-styling": "^1.9.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@jest/globals": "^30.5.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.12.0",
    "eslint-config-next": "^16.4.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "knip": "^6.41.0",
    "next-test-api-route-handler": "^5.0.7",
    "pg-mem": "^3.0.14",
    "postcss": "^8.5.30",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  }
}
