# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/dist

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# sanity
.sanity/*

# Generated media (finished files go to public/)
assets/out/
__pycache__/

# Media stays out of git (public repo). Kept locally and baked into the image at build.
/public/video/
/public/feed/
/public/music/
/assets/**/*.jpg
/assets/**/*.png
/public/icons/
# Julius videos are produced locally and baked into the image at build
public/video/julius/

# gjennomspilling screenshots
/test-results/**/*.png
/test-results/**/*.log
/test-results/gjennomspilling/
/public/audio/
/public/media-inventar.json
/public/spill/
/public/strek/
/public/media-vurdering.json
/public/promo/
/public/_arkiv/
.data/

# Agent scratch (dev server, media clone)
.tmp
