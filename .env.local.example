# Test mode and date mocking
NEXT_PUBLIC_TEST_MODE=false              # bypass date restrictions
NEXT_PUBLIC_BOOT_ANIMATION_DURATION=2    # seconds, 0 = skip
NEXT_PUBLIC_MOCK_DAY=                    # 1-24
NEXT_PUBLIC_MOCK_MONTH=                  # 1-12

# Storage backend: only "localStorage" for now
NEXT_PUBLIC_STORAGE_BACKEND=localStorage
