# Test mode and date mocking
NEXT_PUBLIC_TEST_MODE=false              # bypass date restrictions
NEXT_PUBLIC_BOOT_ANIMATION_DURATION=2    # seconds, 0 = skip
NEXT_PUBLIC_MOCK_DAY=                    # 1-24
NEXT_PUBLIC_MOCK_MONTH=                  # 1-12

# One family
KID_CODE=                                # kids' login, three words
PARENT_CODE=                             # parent guide login
NISSEKOMM_MODE=lan                       # public (kid app only) or lan (guide, /dev, /mcp)
TRUST_PROXY=                             # 1 = trust X-Forwarded-Proto/Host (behind Kourier)

# Storage and media
DATABASE_URL=                            # Postgres; without it an in-memory store
STORAGE_BACKEND=                         # server | localStorage; unset = server when DATABASE_URL is set
MEDIA_DIR=                               # video/audio library, served at /media/*

# MCP and notifications (lan mode)
MCP_CALLERS=                             # {"<sub>": {"name": "...", "level": "read"|"parent"}}
MCP_ISSUER=
MCP_JWKS_URL=
NISSEKOMM_PUBLIC_BASE=                   # absolute media URLs in MCP replies
NOTIFY_CHANNELS=                         # comma list; see src/lib/notify/index.ts
