{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreDependencies": ["pixelarticons", "server-only"],
  "entry": ["scripts/*.mjs"],
  "ignoreExportsUsedInFile": true,
  "next": {
    "entry": [
      "next.config.{js,ts,cjs,mjs}",
      "src/app/layout.{ts,tsx}",
      "src/app/**/layout.{ts,tsx}",
      "src/app/page.{ts,tsx}",
      "src/app/**/page.{ts,tsx}",
      "src/middleware.{ts,tsx}"
    ]
  },
  "ignore": [".claude/**"]
}
