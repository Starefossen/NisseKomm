{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": ["scripts/**/*.ts", "migrations/**/*.ts"],
  "ignoreDependencies": ["pixelarticons"],
  "ignoreExportsUsedInFile": true,
  "next": {
    "entry": [
      "next.config.{js,ts,cjs,mjs}",
      "src/app/layout.{ts,tsx}",
      "src/app/**/layout.{ts,tsx}",
      "src/app/page.{ts,tsx}",
      "src/app/**/page.{ts,tsx}",
      "src/middleware.{ts,tsx}"
    ]
  }
}
